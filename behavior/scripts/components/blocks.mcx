<Component>
  <blocks>
    <block id="luckblock-normal.json">luckBlock</block>
  </blocks>
</Component>
<script lang="ts">
import { BlockComponent } from "@mbler/mcx-component";

const luckBlock = new BlockComponent({
  format: "1.21.80",
  id: "rluckblock:block",
  menu_category: { category: "construction" }
});

luckBlock.setGeometry("minecraft:geometry.full_block");
luckBlock.setLoot("loot_tables/empty.json");

const materialInstances = {
  north: { texture: "luckblock" },
  south: { texture: "luckblock" },
  east: { texture: "luckblock" },
  west: { texture: "luckblock" },
  up: { texture: "luckblock" },
  down: { texture: "luckblock" }
};
luckBlock.setMaterialInstances(materialInstances);
luckBlock.setItemVisual({
  geometry: "minecraft:geometry.full_block",
  material_instances: {
    "*": { texture: "luckblock", render_method: "opaque" }
  }
});

export { luckBlock };
</script>
