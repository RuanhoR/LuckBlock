<Component>
  <items>
    <item id="luckapple.json">LuckApple</item>
  </items>
</Component>

<script lang="ts">
import { ItemComponent } from "@mbler/mcx-component"
import LuckAppleIcon from "./assets/LuckApple.png"
// @ts-ignore name via lang file
const LuckApple = new ItemComponent({
  id: "rluckblock:apple",
  components: {},
  format: "1.21.0",
});
LuckApple.setFood({
  nutrition: 4,
  saturation_modifier: 1.0,
  can_always_eat: true,
});
LuckApple.setUseAnimation("eat");
LuckApple.setUseModifiers({
  use_duration: 1.6,
});
LuckApple.setIcon(LuckAppleIcon);
export {
  LuckApple
}
</script>